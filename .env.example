# Keep this file as placeholders only. Never commit a real LinkedIn session.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
# Optional. Leave blank until a direct section-query contract has been
# verified against the intended deployment environment.
LINKEDIN_PROFILE_COMPONENTS_QUERY_ID=
LINKEDIN_PROFILE_COMPONENTS_VERIFIED_ON=

# Comma-separated API keys for callers of the public deployment.
API_KEYS=replace-with-a-long-random-api-key

CACHE_TTL_SECONDS=900
MIN_REQUEST_INTERVAL_SECONDS=2.5
ENABLE_PUBLIC_FALLBACK=true
LOG_LEVEL=INFO

# Per-API-key request budget. Independent of the LinkedIn-facing pacer above:
# this caps one caller's share of it, not the total volume to LinkedIn.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60
